# МТС EnergyTool — пример переменных окружения. Скопируйте в .env и заполните.
# .env в git не попадает. Без LLM_* веб-приложение работает в демо-режиме.

# OpenAI-совместимый прокси (генерация, эмбеддинги и реранкер через один адрес)
LLM_BASE_URL=
LLM_API_KEY=

# Модели
LLM_MODEL=qwen/qwen3.8-27b
EMB_MODEL=BAAI/bge-m3
RERANKER_MODEL=Qwen/Qwen3-Reranker-8B

# Поиск: 1/0
USE_EMBEDDINGS=1
USE_RERANKER=1
TOP_K=8
RERANKER_TOP_N=24

# Генерация
TEMPERATURE=0.1
MAX_TOKENS=700
LLM_TIMEOUT=60

# Только solution.py
MAX_WORKERS=8
TIME_BUDGET_SEC=1000
# DATA_DIR=data

# Пути веб-приложения
# KB_PATH=data/knowledge-base
# DB_PATH=data/app.db
