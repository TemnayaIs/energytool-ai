# ─────────────────────────────────────────────────────────────────────────────
# МТС EnergyTool — пример переменных окружения.
# Скопируйте в .env и заполните значения. Файл .env в git не попадает.
# Без LLM_* приложение работает в локальном демо-режиме (BM25 + курируемые ответы).
# ─────────────────────────────────────────────────────────────────────────────

# OpenAI-совместимый прокси платформы (обязательно для LLM-режима)
LLM_BASE_URL=
LLM_API_KEY=

# Модели
LLM_MODEL=qwen/qwen3.8-27b
RERANKER_MODEL=qwen/qwen3-reranker-8b
EMB_MODEL=baai/bge-m3

# Параметры генерации и поиска
TEMPERATURE=0.1
MAX_TOKENS=900
TOP_K=6
RERANKER_TOP_N=4
MAX_WORKERS=4
LLM_TIMEOUT=45

# Реранкер включается отдельно: 1/true/yes/on
USE_RERANKER=0

# Пути (по умолчанию — относительно корня проекта)
# KB_PATH=data/knowledge-base
# DB_PATH=data/app.db

# Только для конкурсного solution.py: папка с questions.csv и knowledge-base.zip
# DATA_DIR=data
