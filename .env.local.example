# Локальная Qwen3.8-27B в Unsloth Studio. Скопируйте в .env и впишите ключ из Studio.
LLM_BASE_URL=http://127.0.0.1:8888/v1
LLM_API_KEY=
LLM_MODEL=unsloth/Qwen3.8-27B-GGUF
LLM_TIMEOUT=180
MAX_WORKERS=2
USE_RERANKER=0
USE_EMBEDDINGS=0
